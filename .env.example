# Volcengine DNS Toolkit - Environment Variables Template
# Copy this file to .env and fill in your credentials
# NEVER commit .env to Git!

# Required: Volcengine API Credentials
# Get from: https://console.volcengine.com/iam/keymanage
VOLC_ACCESS_KEY_ID=your-access-key-id-here
VOLC_SECRET_ACCESS_KEY=your-secret-access-key-here

# Optional: API Region (default: cn-beijing)
# Options: cn-beijing, cn-shanghai, cn-guangzhou, ap-singapore-1
VOLC_REGION=cn-beijing

# Optional: DDNS Mode - Domains to auto-update (comma-separated)
DDNS_DOMAINS=example.com,www.example.com

# Optional: Config file path (if not using env vars directly)
# CONF_PATH=/path/to/.env
